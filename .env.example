# Copy to .env and fill in. Never commit .env - it is gitignored.

# Postgres connection string. Use Supabase's Transaction pooler URI (port 6543):
# Supabase Dashboard > Connect > Transaction pooler. Use a separate Supabase
# project for local development so you never touch production data.
DATABASE_URL=

GEMINI_API_KEY="your_gemini_api_key"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key"

# ---- Weekly recap emails ----

# Service role key, from Supabase Dashboard > Settings > API.
# BACKEND ONLY. It bypasses Row Level Security - never put it in app.js or any
# template. Used to look up which accounts have a verified email address.
SUPABASE_SERVICE_ROLE_KEY=""

# 'resend' (default) or 'sendgrid'
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""
# SENDGRID_API_KEY=""

# Must be an address on a domain you have verified with the provider.
WEEKLY_EMAIL_FROM="Trackify <recap@yourdomain.com>"

# Public base URL, used to build links inside emails.
APP_BASE_URL="http://localhost:5001"

# Random secret used to sign unsubscribe links. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Changing it invalidates unsubscribe links in already-delivered emails.
WEEKLY_EMAIL_SECRET=""

# Shared secret for POST /api/jobs/weekly-emails. Generate the same way.
CRON_SECRET=""

# Optional (both default to off/secure):
# FLASK_DEBUG=true
# DISABLE_SSL_VERIFY=true
